---
import EmptyCategoryState from "../components/EmptyCategoryState.astro";
import PostCard from "../components/PostCard.astro";
import Layout from "../layouts/Layout.astro";
import { getArticleCards } from "../lib/articles";

const posts = getArticleCards("berita");
const seo = {
	title: "Berita Berkebun dan Pertanian Rumahan | Taniqo",
	description: "Kumpulan berita Taniqo seputar berkebun rumahan, tanaman, urban farming, dan perkembangan pertanian praktis untuk pembaca Indonesia.",
	canonicalPath: "/berita",
	ogTitle: "Berita Berkebun dan Pertanian Rumahan",
	ogDescription: "Baca kabar dan informasi terbaru tentang berkebun, tanaman rumahan, dan urban farming di Taniqo.",
	image: "/images/thumbnail/dummy-thumbnail.png",
	imageAlt: "Berita berkebun dan pertanian rumahan Taniqo",
	robots: "index, follow",
};
const canonicalUrl = new URL(seo.canonicalPath, Astro.site ?? Astro.url.origin).toString();
const collectionSchema = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: seo.ogTitle,
	description: seo.description,
	url: canonicalUrl,
	isPartOf: {
		"@type": "WebSite",
		name: "Taniqo",
		url: new URL("/", Astro.site ?? Astro.url.origin).toString(),
	},
	mainEntity: {
		"@type": "ItemList",
		name: seo.ogTitle,
		numberOfItems: posts.length,
		itemListElement: posts.map((post, index) => ({
			"@type": "ListItem",
			position: index + 1,
			name: post.title,
			item: new URL(post.href, Astro.site ?? Astro.url.origin).toString(),
		})),
	},
	breadcrumb: {
		"@type": "BreadcrumbList",
		name: "Breadcrumb untuk halaman berita",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "Taniqo",
				item: new URL("/", Astro.site ?? Astro.url.origin).toString(),
			},
			{
				"@type": "ListItem",
				position: 2,
				name: "Berita",
				item: canonicalUrl,
			},
		],
	},
};
---

<Layout
	title={seo.title}
	description={seo.description}
	canonicalUrl={canonicalUrl}
	image={seo.image}
	imageAlt={seo.imageAlt}
	ogTitle={seo.ogTitle}
	ogDescription={seo.ogDescription}
	robots={seo.robots}
>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
	<main class="relative z-0 bg-white py-8 text-zinc-950">
		<section class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
			{posts.length > 0 ? (
				<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
					{posts.map((post) => <PostCard {...post} />)}
				</div>
			) : (
				<EmptyCategoryState category="Berita" />
			)}
		</section>
	</main>
</Layout>
