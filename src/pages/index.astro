---
import PostCard from '../components/PostCard.astro';
import Layout from '../layouts/Layout.astro';
import { getArticleCards } from '../lib/articles';

const posts = getArticleCards();
const seo = {
	title: "Taniqo - Panduan dan Tips Berkebun Rumahan",
	description: "Baca panduan, tips, opini, dan berita berkebun rumahan dari Taniqo untuk merawat tanaman dengan cara yang praktis dan mudah diikuti.",
	canonicalPath: "/",
	ogTitle: "Taniqo - Panduan dan Tips Berkebun Rumahan",
	ogDescription: "Temukan artikel berkebun rumahan, urban farming, perawatan tanaman, dan inspirasi kebun kecil untuk kehidupan sehari-hari.",
	image: "/images/thumbnail/dummy-thumbnail.png",
	imageAlt: "Taniqo panduan berkebun rumahan",
	robots: "index, follow",
};
const canonicalUrl = new URL(seo.canonicalPath, Astro.site ?? Astro.url.origin).toString();
const homepageSchemas = [
	{
		"@context": "https://schema.org",
		"@type": "Organization",
		"@id": `${canonicalUrl}#organization`,
		name: "Taniqo",
		url: canonicalUrl,
		logo: {
			"@type": "ImageObject",
			url: new URL("/favicon.ico", Astro.site ?? Astro.url.origin).toString(),
			width: 48,
			height: 48,
		},
	},
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		"@id": `${canonicalUrl}#website`,
		name: "Taniqo",
		url: canonicalUrl,
		description: seo.description,
		publisher: {
			"@id": `${canonicalUrl}#organization`,
		},
		potentialAction: {
			"@type": "SearchAction",
			target: `${canonicalUrl}search?q={search_term_string}`,
			"query-input": "required name=search_term_string",
		},
	},
];
---

<Layout
	title={seo.title}
	description={seo.description}
	canonicalUrl={canonicalUrl}
	image={seo.image}
	imageAlt={seo.imageAlt}
	ogTitle={seo.ogTitle}
	ogDescription={seo.ogDescription}
	robots={seo.robots}
>
	{homepageSchemas.map((schema) => (
		<script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
	))}
	<main class="relative z-0 bg-white py-8 text-zinc-950">
		<section class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
			<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
				{posts.map((post) => <PostCard {...post} />)}
			</div>
		</section>
	</main>
</Layout>
