---
import PostCard from "../components/PostCard.astro";
import SinglePost from "../components/SinglePost.astro";
import Layout from "../layouts/Layout.astro";
import { getArticleCards, getArticles } from "../lib/articles";
import { buildPostSchema, normalizePostSchemaType } from "../lib/postSchemas";

export function getStaticPaths() {
	return getArticles().map((article) => ({
		params: {
			slug: article.slug,
		},
		props: {
			article,
		},
	}));
}

const { article } = Astro.props;
const Content = article.Content;
const relatedPosts = getArticleCards(article.categorySlug)
	.filter((post) => post.href !== article.href)
	.slice(0, 3);
const canonicalUrl = new URL(article.seo.canonicalPath, Astro.site ?? Astro.url.origin).toString();
const imageUrl = new URL(article.image ?? "/images/thumbnail/dummy-thumbnail.png", Astro.site ?? Astro.url.origin).toString();
const postSchema = buildPostSchema({
	schemaType: normalizePostSchemaType(article.schemaType),
	title: article.title,
	description: article.description,
	category: article.category,
	datePublished: article.datetime,
	author: article.author,
	image: imageUrl,
	url: canonicalUrl,
});
---

<Layout
	title={article.seo.title}
	description={article.seo.description}
	canonicalUrl={canonicalUrl}
	image={article.seo.ogImage}
	imageAlt={article.seo.ogImageAlt}
	ogTitle={article.seo.ogTitle}
	ogDescription={article.seo.ogDescription}
	twitterCard={article.seo.twitterCard}
	type="article"
	robots={article.seo.robots}
>
	<meta slot="head" property="article:published_time" content={article.datetime} />
	<meta slot="head" property="article:modified_time" content={article.datetime} />
	<meta slot="head" property="article:author" content={article.author} />
	<meta slot="head" property="article:section" content={article.category} />
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(postSchema)} />
	<main class="relative z-0 bg-white py-12 text-zinc-950">
		<section class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
			<SinglePost
				title={article.title}
				description={article.description}
				category={article.category}
				date={article.date}
				datetime={article.datetime}
				author={article.author}
				image={article.image}
				imageAlt={article.imageAlt}
			>
				<Content />
			</SinglePost>
		</section>
		{relatedPosts.length > 0 && (
			<section class="mx-auto mt-16 w-full max-w-6xl px-4 sm:px-6 lg:px-8">
				<div class="mb-8 flex items-end justify-between gap-4">
					<h2 class="text-2xl font-semibold text-zinc-950">Related Post</h2>
				</div>
				<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
					{relatedPosts.map((post) => <PostCard {...post} headingLevel="h3" />)}
				</div>
			</section>
		)}
	</main>
</Layout>
