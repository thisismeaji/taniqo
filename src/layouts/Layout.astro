---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	canonicalUrl?: string;
	image?: string;
	imageAlt?: string;
	ogTitle?: string;
	ogDescription?: string;
	twitterCard?: "summary" | "summary_large_image";
	type?: "website" | "article";
	robots?: string;
}

const {
	title = "Taniqo",
	description = "Taniqo menyajikan panduan, tips, dan inspirasi berkebun rumahan yang praktis untuk pembaca Indonesia.",
	canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString(),
	image = "/images/thumbnail/dummy-thumbnail.png",
	imageAlt = title,
	ogTitle = title,
	ogDescription = description,
	twitterCard = "summary_large_image",
	type = "website",
	robots = "index, follow",
} = Astro.props;

const absoluteImageUrl = new URL(image, Astro.site ?? Astro.url.origin).toString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preload" href="/fonts/poppins-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/poppins-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/poppins-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/poppins-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={absoluteImageUrl} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta property="og:site_name" content="Taniqo" />
		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:title" content={ogTitle} />
		<meta name="twitter:description" content={ogDescription} />
		<meta name="twitter:image" content={absoluteImageUrl} />
		<slot name="head" />
	</head>
	<body>
		<SiteHeader />
		<slot />
		<SiteFooter />
	</body>
</html>
