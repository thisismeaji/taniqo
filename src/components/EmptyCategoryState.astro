---
import { FileText } from "@lucide/astro";

interface Props {
	category: string;
}

const { category } = Astro.props;
---

<div class="flex min-h-[22rem] flex-col items-center justify-center text-center">
	<div class="mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-[#E8F5E9] text-[#1B5E20]">
		<FileText size={22} stroke-width={2} aria-hidden="true" />
	</div>
	<h1 class="text-2xl font-semibold text-zinc-950">Belum ada artikel</h1>
	<p class="mt-3 max-w-md text-sm leading-6 text-zinc-600">
		Artikel untuk kategori {category} belum tersedia. Konten terbaru akan tampil di sini setelah ditambahkan.
	</p>
</div>
